{
  "name": "relight",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/infra-up.mjs && turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint && prettier --check .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write . && cargo fmt --all",
    "codegen": "node scripts/codegen.mjs",
    "codegen:check": "node scripts/codegen.mjs && git diff --exit-code -- crates/protocol/src/generated packages/protocol/src/generated && test -z \"$(git status --porcelain -- crates/protocol/src/generated packages/protocol/src/generated)\"",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
